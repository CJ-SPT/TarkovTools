@using SPTarkov.Server.Core.Models.Utils
@inject PresetService PresetService
@inject NavigationManager Navigation
@inject ISptLogger<TarkovToolsMod> Logger;

<MudNavMenu>
    <MudNavGroup Title="Main" Expanded="true">
        <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.Home"
                    Href="/tarkovtools" 
                    Match="NavLinkMatch.All">
            Home
        </MudNavLink>
        
        <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.FactCheck"
                    Href="/tarkovtools"
                    Disabled="true"
                    Match="NavLinkMatch.All">
            Achievements
        </MudNavLink>

        <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.EmojiPeople"
                    Href="/tarkovtools"
                    Disabled="true"
                    Match="NavLinkMatch.All">
            Bots
        </MudNavLink>

        <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.SportsVolleyball"
                    Href="/tarkovtools"
                    Disabled="true"
                    Match="NavLinkMatch.All">
            Globals
        </MudNavLink>

        <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.LocalCafe"
                    Href="/tarkovtools"
                    Disabled="true"
                    Match="NavLinkMatch.All">
            Hideout
        </MudNavLink>

        <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.QuestionAnswer"
                    Href="/tarkovtools/locale-editor"
                    Disabled="!PresetService.IsPresetLoaded"
                    Match="NavLinkMatch.All">
            Locales
        </MudNavLink>
        <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.EditLocation"
                    Href="/tarkovtools"
                    Disabled="true"
                    Match="NavLinkMatch.All">
            Locations
        </MudNavLink>

        <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.SupervisedUserCircle"
                    Href="/tarkovtools"
                    Disabled="true"
                    Match="NavLinkMatch.All">
            Profile Templates
        </MudNavLink>

        <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.LocalLibrary"
                    Href="/tarkovtools"
                    Disabled="true"
                    Match="NavLinkMatch.All">
            Quests
        </MudNavLink>

        <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.KeyboardDoubleArrowUp"
                    Href="/tarkovtools"
                    Disabled="true"
                    Match="NavLinkMatch.All">
            Skills
        </MudNavLink>

        <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.AccountCircle"
                    Href="/tarkovtools/trader-editor"
                    Disabled="!PresetService.IsPresetLoaded"
                    Match="NavLinkMatch.All">
            Traders
        </MudNavLink>

    </MudNavGroup>
    <MudNavGroup Title="Misc" Expanded="true">
        <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.DataObject"
                    Href="/tarkovtools/MongoIdGenerator"
                    Match="NavLinkMatch.All">
            MongoId Generator
        </MudNavLink>
        <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.ConnectedTv"
                    Href="/tarkovtools"
                    Disabled="true"
                    Match="NavLinkMatch.All">
            Example and Reference
        </MudNavLink>
        <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.Settings"
                    Href="/tarkovtools/Settings"
                    Disabled="true"
                    Match="NavLinkMatch.All">
            Settings
        </MudNavLink>
    </MudNavGroup>
</MudNavMenu>

@code
{
    private bool _shouldGoHome;
    
    protected override void OnInitialized()
    {
        PresetService.OnPresetChanged += HandleStateHasChanged;
    }

    public void Dispose()
    {
        PresetService.OnPresetChanged -= HandleStateHasChanged;
    }
    
    private async void HandleStateHasChanged()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await Task.Yield();
                StateHasChanged();
                _shouldGoHome = true;
            });
        }
        catch (Exception e)
        {
            Logger.Error("[TarkovTools] Encountered a critical error during navigation: ", e);
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (_shouldGoHome)
        {
            Navigation.NavigateTo("/tarkovtools");
            _shouldGoHome = false;
        }
        base.OnAfterRender(firstRender);
    }
}