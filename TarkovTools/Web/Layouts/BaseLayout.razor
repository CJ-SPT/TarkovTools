@using TarkovTools.Web.Dialogs
@inherits LayoutComponentBase

@inject ISnackbar Snackbar;
@inject IDialogService DialogService;

@inject PresetService PresetService;
@inject SettingsService SettingsService;

<HeadContent>
    <link href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" rel="stylesheet" />
    <meta name="robots" content="noindex, nofollow">
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&amp;family=Roboto:ital,wght@0,100..900;1,100..900&amp;display=swap" rel="stylesheet">
</HeadContent>

<MudThemeProvider IsDarkMode="true"/>
<MudPopoverProvider/>
<MudSnackbarProvider/>
<MudDialogProvider/>

<main>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <MudLayout>
        <MudAppBar Color="Color.Dark"
                   Fixed="true"
                   Contextual="true"
                   Elevation="4"
                   Bottom="true">

            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width: 100%;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Style="width: 100%;">
                    <!-- Left side -->
                    <MudIconButton Icon="@Icons.Custom.Brands.GitHub"
                                   Color="Color.Inherit"
                                   Href="https://github.com/CJ-SPT/TarkovTools"/>

                    <MudText Style="font-size: 12px">
                        Version: @TarkovToolsMod.Version for SPT: @TarkovToolsMod.SptVersion
                    </MudText>
                </MudStack>
                
                <!-- Right side -->
                <MudSelect T="string"
                           Label="Presets"
                           Variant="Variant.Outlined"
                           Style="max-width: 250px; min-width: 125px; margin-right: 16px; justify-content: center"
                           OnClose="OnPresetSelected"
                           @bind-Value="_selectedPreset">
                    @foreach (var preset in LoadedPresets)
                    {
                        <MudSelectItem Value="@preset">@preset</MudSelectItem>
                    }
                </MudSelect>
                
                <MudButtonGroup Color="Color.Primary"
                                Variant="Variant.Outlined"
                                Style="min-height: 35px; max-height: 45px;"
                                OverrideStyles="false">
                    
                    <MudButton Color="Color.Success" 
                               Style="font-size: 12px;"
                               OnClick="OnSetDefault"
                               Variant="Variant.Outlined">
                        Set Default
                    </MudButton>
                    <MudButton Color="Color.Success" 
                               Style="font-size: 12px;"
                               OnClick="OnSavePreset"
                               Variant="Variant.Outlined">
                        Save Preset
                    </MudButton>
                    <MudButton Color="Color.Warning" 
                               Style="font-size: 12px;"
                               OnClick="OnCreatePreset"
                               Variant="Variant.Outlined">
                        Create Preset
                    </MudButton>
                    <MudButton Color="Color.Secondary" 
                               Style="font-size: 12px;"
                               OnClick="OnDeletePreset"
                               Variant="Variant.Outlined">
                        Delete Preset
                    </MudButton>
                    
                </MudButtonGroup>
                
            </MudStack>
        </MudAppBar>

        <MudDrawer Width="250px" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Never" Elevation="5" Variant="@DrawerVariant.Mini" OpenMiniOnHover="true" Breakpoint="Breakpoint.None">
            <NavMenu/>
        </MudDrawer>
        <MudMainContent Class="pt-1">
            @Body
        </MudMainContent>
    </MudLayout>
</main>

@code {
    private bool _drawerOpen = true;
    private string _selectedPreset;

    private List<string> LoadedPresets => PresetService.LoadedPresets.Select(preset => preset.Name).ToList();

    private void OnSetDefault()
    {
        if (SettingsService.Settings != null && !string.IsNullOrEmpty(_selectedPreset))
        {
            SettingsService.Settings.SelectedPreset = _selectedPreset;
            SettingsService.SaveSettings();
            
            Snackbar.Add($"`{_selectedPreset}` set as default preset.", Severity.Success);
        }
    }
    
    private void OnPresetSelected()
    {
        
    }
    
    private void OnSavePreset()
    {
        if (PresetService.SelectedPreset is null)
        {
            return;
        }
                                    
        PresetService.SavePreset(PresetService.SelectedPreset);
        Snackbar.Add($"`{PresetService.SelectedPreset.Name}` has been saved.", Severity.Success);
    }

    private async Task OnCreatePreset()
    {
        var parameters = new DialogParameters<TextFieldDialog>
        {
            { x => x.Label, "Preset Name" }
        };
        
        var options = new DialogOptions
        {
            CloseButton = true,
            CloseOnEscapeKey = true
        };
        
        var dialog = await DialogService.ShowAsync<TextFieldDialog>("Create new preset", parameters, options);
        var result = await dialog.Result;
        
        if (!result.Canceled)
        {
            var textResult = result.Data?.ToString();
            if (string.IsNullOrEmpty(textResult))
            {
                Snackbar.Add("Failed to create preset. Text field was blank", Severity.Error);
                return;
            }
            
            PresetService.CreatePreset(textResult, true);
            _selectedPreset = textResult;
            
            // Use the result here
            Snackbar.Add($"`{textResult}` created", Severity.Success);
            StateHasChanged();
        }
    }

    private void OnDeletePreset()
    {
        
    }
}