@page "/tarkovtools/locale-editor"
@layout BaseLayout;

@inject CacheService CacheService
@inject PresetService PresetService
@inject LocaleEditService LocaleEditService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">Locale Editor</MudText>

    <MudPaper Class="pa-4 mb-4">
        <MudGrid>
            <MudItem xs="12" sm="5">
                <MudTextField @bind-Value="_newKey" Label="Key" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="5">
                <MudTextField @bind-Value="_newValue" Label="Value" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="2" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                           OnClick="AddLocale" FullWidth="true"
                           Disabled="@(string.IsNullOrWhiteSpace(_newKey) || string.IsNullOrWhiteSpace(_newValue))">
                    Add
                </MudButton>
            </MudItem>
            <MudItem xs="12" sm="5" Class="d-flex align-center">
                <MudTextField @bind-Value="_searchString1" 
                              Placeholder="Search" 
                              Adornment="Adornment.Start" 
                              AdornmentIcon="@Icons.Material.Filled.Search" 
                              IconSize="Size.Medium" Class="mt-0"/>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudTable Items="@_locales"
              Hover="true" 
              Breakpoint="Breakpoint.Sm"
              Dense="true"
              Filter="new Func<KeyValuePair<string, string>, bool>(FilterFunc1)">
        <HeaderContent>
            <MudTh>Key</MudTh>
            <MudTh>Value</MudTh>
            <MudTh Style="width: 150px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Key">
                @if (_editingKey == context.Key)
                {
                    <MudTextField @bind-Value="_editKey" Variant="Variant.Outlined" Margin="Margin.Dense" />
                }
                else
                {
                    <MudText>@context.Key</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Value">
                @if (_editingKey == context.Key)
                {
                    <MudTextField @bind-Value="_editValue" Variant="Variant.Outlined" Margin="Margin.Dense" />
                }
                else
                {
                    <MudText>@context.Value</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Actions">
                @if (_editingKey == context.Key)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" 
                                   Size="Size.Small" OnClick="@(() => SaveEdit(context.Key))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" 
                                   Size="Size.Small" OnClick="CancelEdit" />
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" 
                                   Size="Size.Small" OnClick="@(() => StartEdit(context.Key, context.Value))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" 
                                   Size="Size.Small" OnClick="@(() => DeleteLocale(context.Key))" />
                }
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new []{ 10, 20, 30, 40, 50 }" />
        </PagerContent>
    </MudTable>

    @if (!_locales.Any())
    {
        <MudPaper Class="pa-4 mt-4">
            <MudText Align="Align.Center" Color="Color.Secondary">No locale entries yet. Add your first entry above.</MudText>
        </MudPaper>
    }
</MudContainer>

@code {
    private Dictionary<string, string> _locales = [];
    private string _newKey = string.Empty;
    private string _newValue = string.Empty;
    private string? _editingKey = null;
    private string _editKey = string.Empty;
    private string _editValue = string.Empty;

    private KeyValuePair<string, string> _selectedItem;
    private string _searchString1 = "";
    
    protected override void OnInitialized()
    {
        foreach (var (key, value) in CacheService.GlobalLocales ?? [])
        {
            _locales.Add(key, value);
        }
    }

    private void AddLocale()
    {
        if (PresetService.SelectedPreset is null)
        {
            return;
        }
        
        if (string.IsNullOrWhiteSpace(_newKey) || string.IsNullOrWhiteSpace(_newValue))
        {
            return;
        }

        if (_locales.TryAdd(_newKey, _newValue))
        {
            LocaleEditService.AddOrModifyLocale("en", _newKey, _newValue);
            AddLocaleToPreset("en", _newKey, _newValue);
            return;
        }
        
        _newKey = string.Empty;
        _newValue = string.Empty;
    }

    private void StartEdit(string key, string value)
    {
        if (PresetService.SelectedPreset is null)
        {
            return;
        }
        
        _editingKey = key;
        _editKey = key;
        _editValue = value;
    }

    private void SaveEdit(string originalKey)
    {
        if (PresetService.SelectedPreset is null)
        {
            return;
        }
        
        if (string.IsNullOrWhiteSpace(_editKey) || string.IsNullOrWhiteSpace(_editValue))
        {
            return;
        }

        LocaleEditService.AddOrModifyLocale("en", originalKey, _editValue);
        _locales[originalKey] = _editValue;
        AddLocaleToPreset("en", _editKey, _editValue);
        
        CancelEdit();
    }

    private void CancelEdit()
    {
        if (PresetService.SelectedPreset is null)
        {
            return;
        }
        
        _editingKey = null;
        _editKey = string.Empty;
        _editValue = string.Empty;
    }

    private void DeleteLocale(string key)
    {
        if (PresetService.SelectedPreset is null)
        {
            return;
        }
        
        _locales.Remove(key);
        
        if (_editingKey == key)
        {
            CancelEdit();
        }
    }
    
    private void AddLocaleToPreset(string lang, string key, string value)
    {
        var globalPreset = PresetService.SelectedPreset?.GlobalPreset;
        if (globalPreset is null)
        {
            return;
        }
        
        // Ensure a collection exists for this language
        globalPreset.ModifiedLocales.TryAdd(lang, []);
        var locales = globalPreset.ModifiedLocales[lang];

        if (!locales.TryAdd(key, value))
        {
            locales[key] = value;
        }
        
        globalPreset.HasLocaleModifications = true;
    }
    
    private bool FilterFunc1(KeyValuePair<string, string> locales) => FilterFunc(locales, _searchString1);

    private bool FilterFunc(KeyValuePair<string, string> locale, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
        {
            return true;
        }

        if (locale.Key.Contains(searchString))
        {
            return true;
        }

        if (locale.Value.Contains(searchString))
        {
            return true;
        }
        
        return false;
    }
}