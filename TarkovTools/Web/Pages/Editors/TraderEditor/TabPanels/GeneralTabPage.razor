@using global::TarkovTools.Web.Pages.Editors.TraderEditor.General

<MudGrid Spacing="1" Class="mt-4">
    <MudItem xs="4" sm="4" md="4">
        <!-- Trader Information -->
        <TraderInformationPaper TraderEditor="TraderEditor"/>
    </MudItem>

    <MudItem xs="8" sm="8" md="8">
        <!-- Trader Loyalty Levels -->
        <TraderLoyaltyPaper TraderEditor="TraderEditor"/>
    </MudItem>

    <MudItem xs="12" Class="mb-4">
        <MudDivider/>
    </MudItem>

    <MudItem xs="4" sm="4" md="4">
        <!-- Insurance -->
        <TraderInsurancePaper TraderEditor="TraderEditor"/>
    </MudItem>

    <MudItem xs="4" sm="4" md="4">
        <!-- Repair Configuration -->
        <TraderRepairPaper TraderEditor="TraderEditor"/>
    </MudItem>
    
    <MudItem xs="4" sm="4" md="4">
        <!-- Trader Prohibited Transferable Paper -->
        <TraderProhibitedTransferablePaper TraderEditor="TraderEditor"/>
    </MudItem>
</MudGrid>

@code {
    [Parameter]
    public required TraderEditor TraderEditor { get; init; }
}