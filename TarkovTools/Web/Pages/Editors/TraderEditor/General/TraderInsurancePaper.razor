@using SPTarkov.Server.Core.Models.Common
@using SPTarkov.Server.Core.Models.Eft.Common.Tables
@using SPTarkov.Server.Core.Services

@inject DatabaseService Database;
@inject SearchService SearchService;

<MudPaper Elevation="3" Class="pa-4 mb-4" Style="max-width: 90%;">
    <MudGrid Spacing="1">
        <MudItem xs="6" sm="6" md="6" Class="px-1">
            <MudText Typo="Typo.h6" Class="mb-3">Insurance Configuration</MudText>
        </MudItem>

        <MudItem xs="2" sm="2" md="2" Class="px-1">
            <MudCheckBox T="bool" Label="Available" Value="InsuranceAvailable" bind-Value="InsuranceAvailable" Dense="true"/>
        </MudItem>
        
        <MudDivider/>
        
        <MudItem xs="12" sm="6" Class="px-1">
            <MudNumericField T="int" Label="Max Return Hours" Value="@MaxReturnHour"
                             Variant="Variant.Outlined" Margin="Margin.Dense"/>
            <MudNumericField T="double" Label="Max Storage Time" Value="@MaxStorageTime"
                             Variant="Variant.Outlined" Margin="Margin.Dense"/>
        </MudItem>

        <MudItem xs="12" sm="6" Class="px-1">
            <MudNumericField T="int" Label="Min Return Hours" Value="@MinReturnHour"
                             Variant="Variant.Outlined" Margin="Margin.Dense"/>
            <MudNumericField T="int" Label="Min Payment" Value="@MinPayment"
                             Variant="Variant.Outlined" Margin="Margin.Dense"/>
        </MudItem>

        <InteractableSearchableList
            BreakPoint="6"
            HeaderText="Exclude Categories"
            ShowAddButton="false"
            Items="InsuranceExcludeCategories.Select(x => x.ToString()).ToList()"
            SearchType="SearchResultType.ItemParent"/>
    </MudGrid>
</MudPaper>

@code {
    [Parameter]
    public required TraderEditor TraderEditor { get; init; }

    private TraderInsurance? Insurance => TraderEditor.SelectedTrader?.Base.Insurance;
    
    private bool InsuranceAvailable => Insurance?.Availability ?? false;
    private int MinReturnHour => Insurance?.MinReturnHour ?? 0;
    private int MaxReturnHour => Insurance?.MaxReturnHour ?? 0;
    private double MaxStorageTime => Insurance?.MaxStorageTime ?? 0;
    private int MinPayment => Insurance?.MinPayment ?? 0;
    
    private List<MongoId> InsuranceExcludeCategories => TraderEditor.SelectedTrader?.Base.Insurance?.ExcludedCategory ?? [];
    private readonly List<string> _insuranceLocalizedDisplay = [];
    
    private SearchResult? _parentSearchResult = null!;

    protected override void OnInitialized()
    {
        foreach (var category in InsuranceExcludeCategories)
        {
            var name = SearchService.GetLocalizedName(category);
            _insuranceLocalizedDisplay.Add(name);
        }
        
        base.OnInitialized();
    }
}