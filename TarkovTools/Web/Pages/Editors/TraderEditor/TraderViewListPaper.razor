@using SPTarkov.Server.Core.Models.Common
@using SPTarkov.Server.Core.Models.Eft.Common.Tables
@using SPTarkov.Server.Core.Models.Utils
@using SPTarkov.Server.Core.Services
@using SPTarkov.Server.Core.Utils.Cloners
@using Path = System.IO.Path

@inject ISptLogger<TarkovToolsMod> Logger;
@inject DatabaseService DatabaseService;
@inject SearchService SearchService;
@inject PresetService PresetService;
@inject ChangeTrackerService ChangeTracker;
@inject ICloner Cloner;
@inject ISnackbar Snackbar;

<MudPaper Elevation="2" Class="pa-3" Style="margin-left: 20px; height: calc(100vh - 100px); position: sticky; top: 14px; overflow-y: auto; min-width: 240px;">
    <MudTabs Elevation="0" Centered="true" MinimumTabWidth="30%" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-1" Style="min-width: 240px">
        <MudTabPanel Text="Traders" Style="font-size: 12px;">
            <MudList Dense="true" T="string">
                @foreach (var trader in TraderEditor.GetTraders())
                {
                    var fileName = Path.GetFileNameWithoutExtension(trader.Value.Base.Avatar);
                    var path = $"/tarkovtools/images/traders/{fileName}.png";
                    
                    Console.WriteLine(path);
                    <MudListItem Text="@SearchService.GetLocalizedNickname(trader.Key)" 
                                 OnClick="@(() => SelectTrader(trader.Key))">
                        <AvatarContent>
                            <MudAvatar Size="Size.Medium">
                                <MudImage Src="@path"/>
                            </MudAvatar>
                        </AvatarContent>
                    </MudListItem>
                }
            </MudList>
        </MudTabPanel>
        
        <MudTabPanel Text="My Traders" Style="font-size: 12px;">
            <MudList Dense="true" T="string">
                <MudText Typo="Typo.body2" Class="pa-2" Style="text-align: center">Feature coming soon</MudText>
            </MudList>
        </MudTabPanel>
    </MudTabs>
    
    <MudDivider Class="my-2"/>
    
    <MudButton Variant="Variant.Text" 
               FullWidth="true"
               Color="MudBlazor.Color.Primary" 
               OnClick="@(() => SaveChanges(TraderEditor.SelectedTrader))">
        Save Changes
    </MudButton>
</MudPaper>

@code {
    [Parameter]
    public required TraderEditor TraderEditor { get; init; }
    
    [Parameter]
    public required Action RefreshAction { get; init; }
    
    [Inject] 
    public required IDialogService DialogService { get; set; }

    private Trader? _selectedTraderInList;
    
    private void SelectTrader(MongoId id)
    {
        if (!TraderEditor.GetTraders().TryGetValue(id, out var trader))
        {
            Logger.Error($"[TarkovTools] Could not find tid `{id}` in database when a selecting trader template");
            return;
        }

        if (TraderEditor.SelectedTrader != null)
        {
            SaveChanges(TraderEditor.SelectedTrader);
        }
        
        // Clone the trader so we don't modify it until we save
        TraderEditor.SelectedTrader = Cloner.Clone(trader);

        // Track the new selected trader
        ChangeTracker.TrackObject(TraderEditor.SelectedTrader, "SelectedTrader");
        
        RefreshAction.Invoke();
        TraderEditor.InvokeTraderChanged();
        
        _selectedTraderInList = trader;
        StateHasChanged();
    }
    
    private async Task SaveChanges(Trader? selectedTrader)
    {
        if (selectedTrader is null)
        {
            return;
        }
        
        if (PresetService.SelectedPreset is null)
        {
             Logger.Warning("[TarkovTools] Can't save trader changes when no preset is loaded."); 
             return;
        }
        
        // Set the current traders information in the database
        var traders = DatabaseService.GetTraders();
        if (!traders.ContainsKey(selectedTrader.Base.Id))
        {
            Logger.Error("[TarkovTools] Could not find selected trader in database."); 
            return;
        }
        
        if (!HasChanges())
        {
            Logger.Warning("[TarkovTools] There is nothing to save."); 
            return;
        }
        
        // Update and save the preset
        var traderPreset = PresetService.SelectedPreset.TraderPreset;
        traderPreset.ModifiedTraders.Add(selectedTrader.Base.Id);
        traderPreset.Traders[selectedTrader.Base.Id] = selectedTrader;
        PresetService.SavePreset(PresetService.SelectedPreset);
        
        // Update the trader in the server database
        traders[selectedTrader.Base.Id] = selectedTrader;
        
        Logger.Success($"[TarkovTools] Trader {selectedTrader.Base.Id} changes saved");
        Snackbar.Add("Changes saved.", Severity.Success);
    }
    
    /// <summary>
    ///     Check if there are any changes
    /// </summary>
    /// <returns>True if there are changes</returns>
    private bool HasChanges()
    {
        var selectedTrader = TraderEditor.SelectedTrader;
        return selectedTrader != null && ChangeTracker.HasChanges(selectedTrader, "SelectedTrader");
    }
}